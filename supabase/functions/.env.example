# Copy to supabase/functions/.env (git-ignored) for `supabase functions serve`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Public base URL used to build the inbound URL returned by agents-create.
PUBLIC_INBOUND_BASE_URL=http://127.0.0.1:54321/functions/v1

# LOCAL ONLY: allow http:// and private-network callback URLs so the e2e
# receiver on the host (http://host.docker.internal:8787) is reachable.
# Never set this in a deployed environment.
ALLOW_INSECURE_CALLBACKS=true

# Optional: Firebase service-account JSON (single line) to send real pushes.
# When unset, pushes are skipped and logged as `push_skipped`.
# FCM_SERVICE_ACCOUNT_JSON=

# Shared secret for callbacks-retry (sent by pg_cron as X-Cron-Secret). Must
# match the `cockpit_cron_secret` Vault secret; seed.sql sets this local value.
# Without it, callbacks-retry rejects every request.
CRON_SECRET=cron_local_dev_only_never_use_in_production

# Optional: max inbound actions per agent per minute (default 60).
# INBOUND_RATE_LIMIT_PER_MINUTE=60
