{
  "slug": "content-creator",
  "display_name": "Content creator",
  "description": "Drafts social posts for review in Cockpit.",
  "icon": "sparkles",
  "base_url": "https://content-creator.example.invalid",
  "contract_version": "1.0",
  "min_app_version": null,
  "manifest": {
    "ui": "native",
    "ui_schema_version": 1,
    "ops": {
      "drafts.list": {
        "class": "read",
        "roles": ["owner", "approver"],
        "timeout_ms": 5000,
        "max_request_bytes": 4096,
        "max_response_bytes": 262144
      },
      "drafts.create": {
        "class": "write",
        "roles": ["owner"],
        "timeout_ms": 20000,
        "max_request_bytes": 16384,
        "max_response_bytes": 65536
      },
      "subject.delete": {
        "class": "destructive",
        "roles": ["owner"],
        "timeout_ms": 10000,
        "max_request_bytes": 1024,
        "max_response_bytes": 4096
      }
    },
    "card_types": ["post_draft"],
    "data_categories": ["content", "brand_profile"],
    "deletion_op": "subject.delete",
    "errors": ["validation", "not_found", "conflict", "quota_reached", "trial_ended"]
  }
}
